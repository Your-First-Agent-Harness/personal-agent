{
  "name": "personal-agent",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "A from-scratch Agent Harness with pluggable tools and an offline G1 demo.",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "docs/install.md",
    "docs/releases/v0.3.0.md"
  ],
  "bin": {
    "personal-agent": "./dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./demo": {
      "types": "./dist/demo/g1.d.ts",
      "import": "./dist/demo/g1.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env src/cli/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:acceptance": "node scripts/verify-g1-install.ts",
    "feedback:archive": "node scripts/archive-feedback.ts",
    "check": "npm run lint && npm run typecheck && npm run test",
    "prepack": "npm run build",
