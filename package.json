{
  "name": "personal-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A from-scratch Agent Harness with pluggable tools and an offline G1 demo.",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "docs/install.md",
    "docs/releases/v0.1.0.md"
  ],
  "bin": {
    "personal-agent": "./dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./demo": {
      "types": "./dist/demo/g1.d.ts",
      "import": "./dist/demo/g1.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env src/cli/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:acceptance": "node scripts/verify-g1-install.ts",
    "feedback:archive": "node scripts/archive-feedback.ts",
    "check": "npm run lint && npm run typecheck && npm run test",
    "prepack": "npm run build",
    "demo:g1": "node dist/cli/main.js demo",
    "demo:d015": "node --env-file-if-exists=.env scripts/d015-real-ark.ts",
    "demo:d018": "node scripts/d018-real-repair.ts",
    "demo:d032": "node scripts/d032-multi-tool.ts",
    "demo:d035": "node scripts/d035-external.ts",
    "demo:d037": "node scripts/d037-compare.ts",
    "demo:d039": "node scripts/d039-reconnect.ts",
    "demo:d041": "node scripts/d041-knowledge.ts",
    "demo:d042": "node scripts/d042-weather.ts",
    "demo:d043": "node scripts/d043-sandbox.ts",
    "demo:d044": "node scripts/d044-security.ts",
    "demo:d046": "node scripts/d046-security.ts",
    "demo:d048": "node scripts/d048-dynamic-tools.ts",
    "mcp:server": "node src/demo/d036-mcp-server.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
