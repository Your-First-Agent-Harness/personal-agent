# 复制本文件为 .env 后填入真实值；.env 已被 git 忽略，不要提交
# cp .env.example .env

# 必填：模型密钥（只从环境变量读取，不写进 agent.config.json）
PA_MODEL_API_KEY=sk-your-key-here

# 必填：模型名称，例如 gpt-4o-mini / deepseek-chat / qwen-plus
PA_MODEL_NAME=gpt-4o-mini

# 可选：OpenAI 兼容接口地址，默认 https://api.openai.com/v1
# DeepSeek: https://api.deepseek.com/v1
# 通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
PA_MODEL_BASE_URL=https://api.openai.com/v1

# 可选：日志级别 debug / info / warn / error，默认 info
PA_LOG_LEVEL=info
